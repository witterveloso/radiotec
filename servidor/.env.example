# Copie para .env e troque TODAS as senhas.
DOMAIN=radio.seudominio.com.br
STATION_NAME=Rádio Tec

ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Chave entre o Liquidsoap e o painel (qualquer texto longo e aleatório)
INTERNAL_KEY=troque-por-uma-chave-longa

# Senha que o locutor usa no BUTT/Mixxx para entrar ao vivo
LIVE_PASSWORD=troque-senha-ao-vivo

ICECAST_SOURCE_PASSWORD=troque-senha-icecast
ICECAST_ADMIN_PASSWORD=troque-senha-admin-icecast
ICECAST_MAX_LISTENERS=500

TARGET_LUFS=-16
